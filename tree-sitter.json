{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "harmony",
      "camelcase": "Harmony",
      "title": "Harmony",
      "scope": "source.harmony",
      "file-types": [
        "harmony"
      ],
      "injection-regex": "^harmony$",
      "class-name": "TreeSitterHarmony",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "harmony language support",
    "authors": [
      {
        "name": "Creitin Gameplays",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/CreitinGameplays/tree-sitter-harmony",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
