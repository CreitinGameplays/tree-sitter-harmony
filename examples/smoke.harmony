/// A minimal Harmony smoke test.
copy struct Point {
    x: i32;
    y: i32;
}

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Dot,
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

// A foreign declaration names its ABI (6.8); "C" is the only one implemented.
extern "C" fn abs(x: i32) -> i32;

fn main() {
    let mut p = Point { .x = 10, .y = 20 };
    let nums = [1, 2, 3];

    if (p.x > 0) {
        println("hello\\nHarmony");
    }

    for (i : 0..=2) {
        p.x += nums[i];
    }

    switch (Shape::Dot) {
        case Dot: { println("dot"); }
        case Circle(r): { println("circle {}", r); }
        case Rect(w, h): { println("rect {} {}", w, h); }
    }
}
