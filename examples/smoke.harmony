/// A Harmony smoke test covering v0, v1 and the documented future forms.
copy struct Point {
    x: i32;
    y: i32;
}

enum Shape {
    Circle { radius: f64 },   // v1: named payload fields
    Rect(f64, f64),            // positional payloads still work
    Dot,
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

// v1: a first-class function pointer type and an indirect call.
fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    return f(a, b);
}

// v1: an abilities block and a user-defined generic bound.
abilities Drawable {
    fn label(&self) -> &str;
}

fn show<T: Drawable + ord>(item: &T) -> &str {
    return item.label();
}

// A foreign declaration names its ABI (6.8); "C" is the only one implemented.
extern "C" fn abs(x: i32) -> i32;

// v1: structured `unchecked` reason tags.
unchecked(index_checked, "i is checked against len") fn get(v: &[i32], i: usize) -> i32 {
    return v[i];
}

fn main() {
    let mut p = Point { .x = 10, .y = 20 };
    let nums = [1, 2, 3];

    if (p.x > 0) {
        println("hello\nHarmony");
    }

    for (i : 0..=2) {
        p.x += nums[i];
    }

    // v1: guards and named-field struct patterns.
    switch (Shape::Dot) {
        case Circle { radius: r } if (r > 0.0): { println("circle {}", r); }
        case Rect(w, h): { println("rect {} {}", w, h); }
        case Dot: { println("dot"); }
    }
    switch (p) {
        case Point { x: 0, y: y }: { println("y = {}", y); }
        default: { }
    }

    // v1: else clauses on simple statements.
    let first = nums.get(0) else return;
    let n = add(20, 22) else (e) { return; };
    println("{}", n);

    // v1: function pointers in locals and arrays.
    let f: fn(i32, i32) -> i32 = add;
    let table: [fn(i32, i32) -> i32; 1] = [add];
    println("{}", apply(f, 20, 22));
    println("{}", table[0](1, 2));
}
